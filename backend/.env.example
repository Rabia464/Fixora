# Fixora Backend - Environment Variables Example
# Copy this file to .env and adjust as needed before running the application.

# Application Settings
PROJECT_NAME="Fixora API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
DEBUG=True

# Security
# Generate a secure key using: openssl rand -hex 32
JWT_SECRET_KEY="your-super-secret-key-change-me-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# DEFAULT (zero dependency): if you leave the POSTGRES_* vars unset, Fixora
# runs on a local SQLite file (no external services, no migrations needed).
# Optionally change where that file lives:
# SQLITE_PATH="fixora.db"
#
# PostgreSQL (managed / production): uncomment and fill these in. When
# POSTGRES_SERVER is set, the app builds an asyncpg connection string and
# expects the schema to be managed with `alembic upgrade head`.
# POSTGRES_USER="postgres"
# POSTGRES_PASSWORD="your-db-password"
# POSTGRES_SERVER="localhost"
# POSTGRES_PORT="5432"
# POSTGRES_DB="fixora"
#
# Or set a full URL directly (takes precedence over everything above):
# SQLALCHEMY_DATABASE_URI="postgresql+asyncpg://user:pass@host:5432/fixora"
