# Fixora — copy to .env.local for local development.

# Firebase Admin credentials. Any ONE of:
#   - a serviceAccountKey.json next to package.json (gitignored), or
#   - the same JSON as a single-line string here:
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
#   - or the split form:
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Secret used to sign access tokens (HS256). Required in production, >= 32 chars.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=

# Only set this if pointing the UI at a separately hosted API. Defaults to the
# built-in /api/v1 route handlers.
# NEXT_PUBLIC_API_URL=
